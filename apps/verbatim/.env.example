# Copy lives in ~/.config/lecture-transcriber/.env (chmod 600). Never commit real keys.

# https://console.groq.com/keys  — Whisper transcription + fallback LLM
GROQ_API_KEY=

# https://aistudio.google.com/apikey  — use a PERSONAL Google account
# (KU Leuven Workspace accounts often have AI Studio disabled)
GEMINI_API_KEY=

# Optional extra fallback: https://openrouter.ai/keys
OPENROUTER_API_KEY=
