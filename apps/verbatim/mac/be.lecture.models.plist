<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Model server for Lecture Transcriber (PLAN.md 4b). A LaunchDaemon so it starts at boot without a
     login (the Mac has no auto-login); runs as the user, not root. Install: see mac/README.md. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>be.lecture.models</string>
  <key>UserName</key>
  <string>__USER__</string>
  <key>GroupName</key>
  <string>staff</string>
  <key>ProgramArguments</key>
  <array>
    <!-- the venv's python directly: no `uv run` re-sync (or network) at boot -->
    <string>__HOME__/lecture-transcriber/.venv/bin/python</string>
    <string>__HOME__/lecture-transcriber/server.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/lecture-transcriber</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <!-- restarted when it exits, e.g. while the Tailscale address isn't up yet at boot -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/lecture-transcriber/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/lecture-transcriber/logs/server.log</string>
</dict>
</plist>
